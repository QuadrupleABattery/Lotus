--!strict

local freeThreads : {thread} = {}

local Signal = {}
local Connection = {}

export type Signal<T...> = {
	_head            : LinkNode,
	_tail            : LinkNode,
	_size            : number,
	_tempConnections : {Connection},
	
	Connect          : (self : Signal<T...>, func : Callback<T...>) -> Connection,
	Once             : (self : Signal<T...>, func : Callback<T...>) -> Connection,
	Wait             : (self : Signal<T...>                       ) -> T...,
	DisconnectAll    : (self : Signal<T...>                       ) -> (),
	Fire             : (self : Signal<T...>, T...                 ) -> (),
}

export type Connection = {
	_signal    : Signal<any>,
	_node      : LinkNode?,
	Disconnect : (self : Connection) -> (),
}

type LinkNode = {
	_previous   : LinkNode?,
	_next       : LinkNode?,
	_connection : Connection?,
	_fn         : Callback<any>,
}

type Callback<T...> = (T...) -> ()

local function runCallback<T...>(thread : thread, callback : Callback<T...>, ... : T...) : ()
	callback(...)
	table.insert(freeThreads, thread)
end

local function threadFunction<T...>() : ()
	while true do
		runCallback(coroutine.yield())
	end
end

function Connection.new<T...>(signal : Signal<T...>, node : LinkNode) : Connection
	return setmetatable({
		_signal = signal,
		_node = node :: LinkNode?,
		Disconnect = Connection.Disconnect,
	}, Connection)
end

function Signal.new<T...>() : Signal<T...>
	local node = {} :: LinkNode

	return {
		_head = node,
		_tail = node,
		_size = 1,
		_tempConnections = {},
		Connect = Signal.Connect,
		DisconnectAll = Signal.DisconnectAll,
		Fire = Signal.Fire,
		Once = Signal.Once,
		Wait = Signal.Wait,
	}
end

function Signal.Connect<T...>(self : Signal<T...>, callback : Callback<T...>) : Connection
	local node : LinkNode

	if self._head._connection == nil then
		self._head._fn = callback
		node = self._head
	else
		local newNode: LinkNode = {
			_previous = self._tail,
			_fn = callback,
		}

		newNode._previous = self._tail

		self._tail._next = newNode
		self._tail = newNode

		node = newNode

		self._size += 1
	end

	local connection = {
		_signal = self,
		_node = node,
		Disconnect = Connection.Disconnect,
	}

	node._connection = connection :: Connection?
	return connection :: Connection
end

function Signal.Once<T...>(self : Signal<T...>, callback : Callback<T...>) : Connection
	local tempConnection = self:Connect(callback)

	table.insert(self._tempConnections, tempConnection)

	return tempConnection
end

function Signal.Wait<T...>(self : Signal<T...>) : T...
	local callThread = coroutine.running()

	local function resumeThread(... : T...)
		coroutine.resume(callThread, ...)
	end

	self:Once(resumeThread)

	return coroutine.yield()
end

@native function Signal.Fire<T...>(self : Signal<T...>, ... : T...) : ()
	local node = self._head

	if node._connection == nil then
		return
	end

	for i = 1, self._size do
		local freeThread : thread? = nil
		local length = #freeThreads

		freeThread = freeThreads[length]

		if freeThread == nil then
			freeThread = task.spawn(threadFunction)
		else
			freeThreads[length] = nil
		end

		coroutine.resume(freeThread, freeThread, node._fn, ...)

		node = node._next
	end

	if #self._tempConnections > 0 then
		for _, temp in self._tempConnections do
			temp:Disconnect()
		end
	end

	
	
	return
end

@native function Signal.DisconnectAll<T...>(self : Signal<T...>) : ()
	local node = {
		_fn = function() end,
		_connection = {} :: Connection,
	} :: LinkNode



	self._head = node
	self._tail = node
	self._size = 1

	return
end

function Connection.Disconnect(self : Connection) : ()
	local signal = self._signal
	local node : LinkNode? = self._node

	if node == nil then
		return
	end

	local nextNode = node._next
	local prevNode = node._previous

	if nextNode ~= nil then
		nextNode._previous = prevNode
		node._next = nil
	end

	if prevNode then
		prevNode._next = nextNode
		node._previous = nil
	elseif signal._head == node then
		if nextNode ~= nil then
			signal._head = nextNode
		end
	end

	if node._connection ~= nil then
		node._connection._node = nil
		node._connection = nil
	end

	signal._size -= 1

	return
end

return Signal
